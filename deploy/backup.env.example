# Signal Sports — backup and dev-snapshot settings for deploy/backup.sh and
# deploy/devsnap.sh. On the host: /etc/signal/backup.env, root:root, mode 0600
# (the scripts refuse any other mode). KEY=VALUE lines only; it is read, never
# executed. Never commit the real file; never put a PRIVATE age key on the host.

# ── Full backups ──────────────────────────────────────────────────────────────
# PUBLIC age recipient(s) of the backup key ("age1..." lines). The matching
# private key stays OFFLINE with the owner (password manager + paper).
BACKUP_RECIPIENTS_FILE=/etc/signal/backup-recipients.txt
# Where encrypted copies wait locally (root 0700). Default: next to the data dir.
# BACKUP_ENC_DIR=/srv/signal/prod/backups-enc
# b2:<bucket>  (Backblaze B2, write-only key below)  or  local:<dir> (a second disk)
OFFSITE_TARGET=b2:REPLACE-backup-bucket
# Object names: <prefix>/<daily|weekly|monthly>/signal_<UTC>.db.gz.age
OFFSITE_PREFIX=prod
# B2 application key restricted to the backup bucket, capabilities writeFiles
# only (offsite_upload.py refuses delete/governance/bucket/key capabilities).
# SECRET.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
# Local plaintext and encrypted copies older than this are pruned.
LOCAL_KEEP_DAYS=7
# healthchecks-style URL, pinged ONLY after a successful upload; /fail on error.
# SECRET (anyone with it can fake a success).
MONITOR_BACKUP_URL=

# ── Dev snapshots (a separate key, bucket and credential) ─────────────────────
# PUBLIC recipient of the DEV key. Must not include any backup recipient.
DEVSNAP_RECIPIENTS_FILE=/etc/signal/devsnap-recipients.txt
DEVSNAP_TARGET=b2:REPLACE-devsnap-bucket
DEVSNAP_PREFIX=devsnap
# Write-only key for the dev-snapshot bucket ONLY. SECRET.
DEVSNAP_B2_APPLICATION_KEY_ID=
DEVSNAP_B2_APPLICATION_KEY=
DEVSNAP_KEEP=4
