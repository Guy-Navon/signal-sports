# Signal Sports — application settings for the hosted stack (#263, #265).
#
# Copy to the host as /etc/signal/prod.env (root:root, mode 0600) and point
# SIGNAL_ENV_FILE at it. NEVER commit the real file; keep secrets out of git,
# issues, PRs, chat and images. Every key is listed; secrets are blank.
#
# These defaults start SAFELY ON AN EMPTY DATABASE: no worker, no LLM calls,
# no Telegram, no results sync. Each external side effect is switched on
# deliberately, in the order of docs/DEPLOYMENT.md (the worker comes last).

# ── Deployment mode (#265) ────────────────────────────────────────────────────
DEPLOY_ENV=hosted

# ── Auth ──────────────────────────────────────────────────────────────────────
# The exact https origin the browser uses, e.g. https://<machine>.<tailnet>.ts.net
# (no trailing slash). Personal hostnames stay in the host's file, not in git.
CSRF_ALLOWED_ORIGINS=
AUTH_COOKIE_SECURE=true
AUTH_SIGNUP_ENABLED=false
# Closed signup still admits these addresses (comma-separated). Every password
# signup proves its address with an emailed link before the account exists.
AUTH_SIGNUP_ALLOWED_EMAILS=
# Bootstraps the admin on first start. SECRET (password).
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
ALLOW_INSECURE_AUTH_BYPASS=false
ALLOW_DEV_RESET=false
ALLOW_CORPUS_DB_RESET=false

# ── Verification email (password signups) ────────────────────────────────────
# smtp is the only hosted backend (console/memory are refused). STARTTLS on
# 587: Hetzner Cloud blocks outbound 25 and 465. Unset = no mailer, and
# password signup answers 503 rather than skipping verification.
MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# SECRET.
SMTP_PASSWORD=
# e.g. Signal Sports <no-reply@your-domain>; the domain needs SPF + DKIM for
# the provider and a DMARC record.
MAIL_FROM=
# Base of the links in verification emails (https, no trailing slash).
# Never derived from the request's Host header.
APP_PUBLIC_URL=

# ── Google sign-in (docs/DEPLOYMENT.md §3.2) ─────────────────────────────────
# Off unless all three are set. The redirect URI is <origin>/api/auth/google/callback
# and must be registered in the Google Cloud console. SECRET: the client secret.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ── Scheduler worker ──────────────────────────────────────────────────────────
# false until the cutover (#269): a worker on an empty DB starts a second,
# diverging corpus. The worker service also needs COMPOSE_PROFILES=worker.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_RUN_ON_STARTUP=false
SCHEDULER_STARTUP_CATCHUP=true
SCHEDULER_MAX_RUN_SECONDS=900
SCHEDULER_STALE_AFTER_SECONDS=1800

# ── Classification (docs/LLM_CLASSIFICATION.md) ──────────────────────────────
# disabled until the hosted-provider evaluation (#262) picks one.
CLASSIFICATION_PROVIDER=disabled
CLASSIFICATION_MODEL=
# SECRET when a hosted provider is chosen.
CLASSIFICATION_API_KEY=
CLASSIFICATION_TIMEOUT_SECONDS=15
CLASSIFICATION_LLM_GATING=enabled

# ── Feed behaviour (production values on the PC today) ───────────────────────
CLUSTERING_ENABLED=true
FEED_FRESHNESS_ENABLED=true
FEED_MAX_AGE_HOURS=36
# Must stay off until rated rows are protected (#255).
RETENTION_CLEANUP_ENABLED=false

# ── Translation ───────────────────────────────────────────────────────────────
TRANSLATION_PROVIDER=disabled
TRANSLATION_API_KEY=

# ── Telegram (#251) ───────────────────────────────────────────────────────────
TELEGRAM_NOTIFICATIONS_ENABLED=false
# SECRETS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_SECONDS=20

# ── Results (#178) ────────────────────────────────────────────────────────────
RESULTS_ENABLED=true
# Network activity: switch on with the worker at the cutover.
RESULTS_SYNC_ENABLED=false
RESULTS_PROVIDER=thesportsdb
THESPORTSDB_API_KEY=3

# ── Monitoring (docs/DEPLOYMENT.md section 7) ─────────────────────────────────
# healthchecks.io-style ping URLs, one check each. Empty = off. SECRETS: anyone
# holding a URL can fake a success. The backup check's URL goes in backup.env.
MONITOR_CYCLE_URL=
MONITOR_SOURCES_URL=
MONITOR_FRESH_URL=
MONITOR_TIMEOUT_SECONDS=5
