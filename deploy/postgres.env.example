# Signal Sports — settings for the db service in compose.yaml (profile
# "postgres"). GROUNDWORK ONLY: nothing connects to this database; the app
# still runs on SQLite (docs/DEPLOYMENT.md, "Postgres groundwork").
#
# Copy to deploy/postgres.env (or point SIGNAL_POSTGRES_ENV_FILE at it), mode
# 0600. NEVER commit the real file; keep the password out of git, issues, PRs,
# chat and images. KEY=VALUE lines only.
#
# Read by the image on FIRST start only, when it initializes an empty data dir.
# Changing them later does not change an existing database.

POSTGRES_DB=signal
POSTGRES_USER=signal
# SECRET. A long random value, e.g. `openssl rand -hex 24`. Without it the
# image refuses to initialize.
POSTGRES_PASSWORD=
