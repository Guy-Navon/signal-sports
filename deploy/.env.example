# Compose interpolation for deploy/compose.yaml. Copy to deploy/.env on the
# host (or export the variables). No secrets here: app settings and secrets go
# in the file SIGNAL_ENV_FILE names.

# Images by DIGEST (immutable), as printed by the publish workflow.
SIGNAL_BACKEND_IMAGE=ghcr.io/OWNER/signal-backend@sha256:REPLACE
SIGNAL_WEB_IMAGE=ghcr.io/OWNER/signal-web@sha256:REPLACE

SIGNAL_ENV_FILE=/etc/signal/prod.env
SIGNAL_DATA_DIR=/srv/signal/prod/data
SIGNAL_WEB_BIND=127.0.0.1
SIGNAL_WEB_PORT=8080

# Empty = no worker. Set to "worker" at the cutover, last (docs/DEPLOYMENT.md).
COMPOSE_PROFILES=
